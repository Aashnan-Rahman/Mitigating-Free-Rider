\newlabel{scatter-mnist-40-legend}{{\expandafter\protect\csname pgfplots@legend@to@name@scatter-mnist-40-legend\endcsname}{9}{Representative Score Geometry and Evidence Evolution}{pgfplotslink.5.0}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces MNIST: round-20 score geometry at 40\% free riders (all eight settings). One point is one client, averaging the A/B norm-z and profile-z scores separately. The monotone asinh display compresses extreme tails without clipping; zero remains zero, but distances are transformed. Panels autoscale independently. Labels color evaluation only, never references or decisions. 0 points have undefined coordinates and are omitted; coincident points overlap. No plotted line is a removal cutoff.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:scatter-mnist-40}{{1}{9}{MNIST: round-20 score geometry at 40\% free riders (all eight settings). One point is one client, averaging the A/B norm-z and profile-z scores separately. The monotone asinh display compresses extreme tails without clipping; zero remains zero, but distances are transformed. Panels autoscale independently. Labels color evaluation only, never references or decisions. 0 points have undefined coordinates and are omitted; coincident points overlap. No plotted line is a removal cutoff}{figure.1}{}}
\newlabel{scatter-cifar10-40-legend}{{\expandafter\protect\csname pgfplots@legend@to@name@scatter-cifar10-40-legend\endcsname}{10}{Representative Score Geometry and Evidence Evolution}{pgfplotslink.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces CIFAR-10: round-20 score geometry at 40\% free riders (all eight settings). One point is one client, averaging the A/B norm-z and profile-z scores separately. The monotone asinh display compresses extreme tails without clipping; zero remains zero, but distances are transformed. Panels autoscale independently. Labels color evaluation only, never references or decisions. 0 points have undefined coordinates and are omitted; coincident points overlap. No plotted line is a removal cutoff.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:scatter-cifar10-40}{{2}{10}{CIFAR-10: round-20 score geometry at 40\% free riders (all eight settings). One point is one client, averaging the A/B norm-z and profile-z scores separately. The monotone asinh display compresses extreme tails without clipping; zero remains zero, but distances are transformed. Panels autoscale independently. Labels color evaluation only, never references or decisions. 0 points have undefined coordinates and are omitted; coincident points overlap. No plotted line is a removal cutoff}{figure.2}{}}
\newlabel{norm-hist-legend}{{\expandafter\protect\csname pgfplots@legend@to@name@norm-hist-legend\endcsname}{11}{Representative Score Geometry and Evidence Evolution}{pgfplotslink.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces CIFAR-10 non-IID FR3: raw selected trap-A norm distributions. Shared population-derived equal-width bins within each panel, independent axes across panels; colors may overlap. Annotations count FRESH norm certificates on BOTH traps (H: honest, FR: free rider). Confirming cycles are 20/60 at 40\% and 40/80 at 30\%; the other panels show ambiguity. A visual gap alone cannot authorize removal.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:norm-hist}{{3}{11}{CIFAR-10 non-IID FR3: raw selected trap-A norm distributions. Shared population-derived equal-width bins within each panel, independent axes across panels; colors may overlap. Annotations count FRESH norm certificates on BOTH traps (H: honest, FR: free rider). Confirming cycles are 20/60 at 40\% and 40/80 at 30\%; the other panels show ambiguity. A visual gap alone cannot authorize removal}{figure.3}{}}
