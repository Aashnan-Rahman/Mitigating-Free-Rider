\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Attack-specific whole-simulator resource profiles for the representative replication: mean logged round time (top) and peak process RSS (bottom). Four bars per attack distinguish partition and free-rider share. Dataset panels use independent numeric scales. FR3/FR4 memory includes simulated history storage; these bars do not measure detector-only overhead.}}{14}{figure.6}\protected@file@percent }
\newlabel{fig:resources}{{6}{14}{Attack-specific whole-simulator resource profiles for the representative replication: mean logged round time (top) and peak process RSS (bottom). Four bars per attack distinguish partition and free-rider share. Dataset panels use independent numeric scales. FR3/FR4 memory includes simulated history storage; these bars do not measure detector-only overhead}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Historical whole-process comparison: CIFAR-10, non-IID, 40\%, seed 42, CPU, 100 rounds. Only completed matching v15.3 runs are included.}}{15}{table.4}\protected@file@percent }
\newlabel{tab:historical-cost}{{IV}{15}{Historical whole-process comparison: CIFAR-10, non-IID, 40\%, seed 42, CPU, 100 rounds. Only completed matching v15.3 runs are included}{table.4}{}}
\newlabel{timing-segments-legend}{{\expandafter\protect\csname pgfplots@legend@to@name@timing-segments-legend\endcsname}{16}{Measured 100-Round Native-Workflow Timing}{pgfplotslink.5.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Mean timing over 100 executed rounds per method and dataset: non-IID FR3, seed 42, 100 initial clients, 40\% free riders. STD-DAGMM has measured task components; our gray bars are undivided whole-round totals, not zero-cost detection. Both means include rounds 1--100. Different trajectories, timer coverage and host load prevent a causal speedup claim.}}{16}{figure.7}\protected@file@percent }
\newlabel{fig:timing-segments}{{7}{16}{Mean timing over 100 executed rounds per method and dataset: non-IID FR3, seed 42, 100 initial clients, 40\% free riders. STD-DAGMM has measured task components; our gray bars are undivided whole-round totals, not zero-cost detection. Both means include rounds 1--100. Different trajectories, timer coverage and host load prevent a causal speedup claim}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Where our 100-round runtime is spent (non-IID FR3, seed 42, 40\% free riders). Rows separate MNIST and CIFAR-10. Left: mean duration of a complete round in each category. Right: summed duration for that category divided by 100; the five bars add to the full-run mean printed in the title. Labels give category counts $n$. Probe excludes cycle-decision rounds; Cycle includes the final cycle decision; Audit is a single audit round. Categories are mutually exclusive. A cycle bar includes client training, aggregation and evaluation: it is NOT detector-only time. Axes scale independently; all bars start at zero.}}{16}{figure.8}\protected@file@percent }
\newlabel{fig:timing-phases}{{8}{16}{Where our 100-round runtime is spent (non-IID FR3, seed 42, 40\% free riders). Rows separate MNIST and CIFAR-10. Left: mean duration of a complete round in each category. Right: summed duration for that category divided by 100; the five bars add to the full-run mean printed in the title. Labels give category counts $n$. Probe excludes cycle-decision rounds; Cycle includes the final cycle decision; Audit is a single audit round. Categories are mutually exclusive. A cycle bar includes client training, aggregation and evaluation: it is NOT detector-only time. Axes scale independently; all bars start at zero}{figure.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Measured STD-DAGMM component times (seconds per round, mean $\pm $ sample SD, 100 rounds per dataset).}}{17}{table.5}\protected@file@percent }
\newlabel{tab:std-segments}{{V}{17}{Measured STD-DAGMM component times (seconds per round, mean $\pm $ sample SD, 100 rounds per dataset)}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Native-workflow timing over 100 executed rounds per method and dataset. All entries are measured; this is not a controlled speedup experiment.}}{17}{table.6}\protected@file@percent }
\newlabel{tab:timing-horizons}{{VI}{17}{Native-workflow timing over 100 executed rounds per method and dataset. All entries are measured; this is not a controlled speedup experiment}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Our 100 measured rounds grouped by events. Within-category mean is not detector-only overhead; amortized contribution is category sum / 100.}}{17}{table.7}\protected@file@percent }
