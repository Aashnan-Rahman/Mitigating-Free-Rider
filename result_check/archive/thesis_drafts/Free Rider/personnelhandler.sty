\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{personnelhandler}[2024/09/26 v0.51 LaTeX package for multiple author (student) management for IUT BSc Thesis Template]

% Prerequisite package loading
\RequirePackage{etoolbox}

%%% AUTHOR %%%
\renewcommand{\author}[2]{
    \gdef\@AuthorName{#1}
    \gdef\@AuthorID{#2}
}

\newcommand{\getAuthorName}{\@AuthorName}
\newcommand{\getAuthorID}{\@AuthorID}
\newcommand{\getAuthorQName}{\getAuthorName\ with student ID \getAuthorID}

%%% SUPERVISOR %%%
\newcommand{\supervisor}[3]{%
    \gdef\@SupervisorName{#1}%
    \gdef\@SupervisorDesignation{#2}%
    \gdef\@SupervisorDepartment{#3}%
}

\newcommand{\getSupervisorName}{\@SupervisorName}
\newcommand{\getSupervisorDesignation}{\@SupervisorDesignation}
\newcommand{\getSupervisorDepartment}{\@SupervisorDepartment}
\newcommand{\getSupervisorQName}{\getSupervisorName, \getSupervisorDesignation, \getSupervisorDepartment, Islamic University of Technology (IUT), Dhaka, Bangladesh}

%%% COSUPERVISOR %%%
\newcommand{\cosupervisor}[4]{%
    \gdef\@CoSupervisorName{#1}%
    \gdef\@CoSupervisorDesignation{#2}%
    \gdef\@CoSupervisorDepartment{#3}%
    \gdef\@CoSupervisorOrganization{#4}%
}

\newcommand{\getCoSupervisorName}{\@CoSupervisorName}

\newcommand{\getCoSupervisorDesignation}{\@CoSupervisorDesignation}

\newcommand{\getCoSupervisorDepartment}{\@CoSupervisorDepartment}

\newcommand{\getCoSupervisorOrganization}{\@CoSupervisorOrganization}

\newcommand{\getCoSupervisorQName}{\getCoSupervisorName, \getCoSupervisorDesignation, \getCoSupervisorDepartment, \getCoSupervisorOrganization}

\newcommand{\ifhascosupervisor}[1]{%
  \if\relax\detokenize\expandafter{\@CoSupervisorName}\relax
      % If empty, execute the second argument
  \else
    #1  % If not empty, execute the first argument
  \fi
}

\newcommand{\clearcosupervisor}{%
    \cosupervisor{}{}{}{}
}

\clearcosupervisor

