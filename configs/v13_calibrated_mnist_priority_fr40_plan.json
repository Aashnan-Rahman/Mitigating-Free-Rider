{
  "batch_name": "v13_calibrated_mnist_priority_fr40",
  "results_root": "./results",
  "defaults": {
    "methodology_version": "swtcp_v13",
    "dataset": "mnist",
    "num_clients": 100,
    "num_rounds": 100,
    "free_rider_pct": 0.4,
    "dirichlet_alpha": 0.5,
    "seed": 42,
    "device": "auto",
    "save_checkpoints": true,
    "checkpoint_keep_last": 5
  },
  "stages": [
    {
      "id": "hardest_noniid_fr4",
      "id_format": "v13_calibrated_mnist_{distribution}_fr40_seed{seed}_{attack_type}",
      "matrix": {"distribution": ["noniid"], "attack_type": ["FR4"], "seed": [42, 43, 46]}
    },
    {
      "id": "remaining_noniid",
      "id_format": "v13_calibrated_mnist_{distribution}_fr40_seed{seed}_{attack_type}",
      "matrix": {"distribution": ["noniid"], "attack_type": ["FR3", "FR2", "FR1"], "seed": [42]}
    },
    {
      "id": "iid",
      "id_format": "v13_calibrated_mnist_{distribution}_fr40_seed{seed}_{attack_type}",
      "matrix": {"distribution": ["iid"], "attack_type": ["FR3", "FR4", "FR2", "FR1"], "seed": [42]}
    }
  ]
}
