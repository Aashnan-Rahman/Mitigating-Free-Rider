# Local Python environments and regenerated caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Recovery checkpoints are runtime state, not completed research evidence.
checkpoint_round_*.pt
latest_checkpoint.pt

# Live monitor files remain local; completed experiment batches are retained.
/results/experiment_status.json
/results/scheduled_resume.log

# Recoverable historical-run cleanup; see result_check/cleanup_2026_10_15.json.
/.local_cleanup/

# Paper sources and final PDFs are retained; compilation scratch is regenerated.
/result_check/paper_version_staging/versions/*/build/

# Native STD-DAGMM benchmark transient full-response matrices, not final evidence.
/analysis/std_dagmm_mnist_native_*/.runtime/
/analysis/std_dagmm_cifar10_native_*/.runtime/
/analysis/timing_breakdown/build/
previous_checkpoint.pt
/results/std_dagmm_100_seed42_fr40/*/.runtime/
/results/std_dagmm_100_seed42_fr40/.runtime/
/results/std_dagmm_recovery.log
# Live no-detection batch stays local until completion; metrics/models are retained.
/results/fedavg_cifar10_baseline_seed42_fr30_fr40/
